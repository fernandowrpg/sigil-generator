<div class="sigil-generator">

  <div class="runa-preview">{{{svg}}}</div>

  <div class="form-group">
    <label>{{localize "RUNABUILDER.Seed"}}</label>
    <div class="form-fields seed-row">
      <input type="number" name="seed" value="{{seed}}">
      <button type="button" data-action="applySeed">{{localize "RUNABUILDER.Apply"}}</button>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "RUNABUILDER.Name"}}</label>
    <input type="text" name="name" value="{{name}}">
  </div>

  <div class="form-group">
    <label>{{localize "RUNABUILDER.Power"}}</label>
    <input type="text" name="power" value="{{power}}">
  </div>

  <div class="form-group">
    <label>{{localize "RUNABUILDER.Description"}}</label>
    <textarea name="description" rows="3">{{description}}</textarea>
  </div>

  <fieldset class="item-options">
    <legend>{{localize "RUNABUILDER.ItemSection"}}</legend>

    <label class="checkbox-row">
      <input type="checkbox" name="createItem" {{#if createItem}}checked{{/if}} {{#unless hasItemTypes}}disabled{{/unless}}>
      <span>{{localize "RUNABUILDER.CreateItem"}}</span>
    </label>

    {{#if hasItemTypes}}
    <div class="form-group">
      <label>{{localize "RUNABUILDER.ItemType"}}</label>
      <select name="itemType">
        {{#each itemTypes}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label>{{localize "RUNABUILDER.GiveTo"}}</label>
      <select name="actorId">
        <option value="">{{localize "RUNABUILDER.GiveToNone"}}</option>
        {{#each actors}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>
    {{else}}
    <p class="hint">{{localize "RUNABUILDER.ItemNoTypes"}}</p>
    {{/if}}

    <label class="checkbox-row">
      <input type="checkbox" name="reveal" {{#if reveal}}checked{{/if}}>
      <span>{{localize "RUNABUILDER.RevealJournal"}}</span>
    </label>
  </fieldset>

  <footer class="sheet-footer">
    <button type="button" data-action="regenerate">
      <i class="fa-solid fa-dice"></i> {{localize "RUNABUILDER.Regenerate"}}
    </button>
    <button type="button" data-action="create" {{#unless isGM}}disabled{{/unless}}>
      <i class="fa-solid fa-box-archive"></i> {{localize "RUNABUILDER.CreateAndPlace"}}
    </button>
  </footer>

  {{#unless isGM}}
    <p class="hint gm-only-hint">{{localize "RUNABUILDER.OnlyGM"}}</p>
  {{/unless}}

</div>
